# CARIA-GAP backend environment (Roadmap Phase 1+).
# Copy to .env and fill in. The app runs without these today (local-first stores);
# they take effect once the routers are repointed to the database.

# SQLAlchemy URL read by models/db_session.py and migrations/env.py.
# Managed Postgres (production / staging):
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/caria
# Local SQLite for a quick demo (no Postgres needed):
# DATABASE_URL=sqlite:///./data/caria_dev.db

# --- Phase 2 (auth) ---
# Secret the backend signs + validates its own bearer token with (verify-student).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=change-me-to-a-long-random-string

# --- Phase 4 (hardening) ---
# Comma-separated allowed CORS origins (your prod frontend domain). Vercel preview
# deploys are matched by CORS_ORIGIN_REGEX. Defaults to localhost dev origins.
CORS_ORIGINS=https://your-frontend-domain.com
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
