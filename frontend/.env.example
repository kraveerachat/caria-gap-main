# CARIA-GAP frontend environment. Copy the ones you need into `.env.local`
# (gitignored). Next.js does NOT load this .example file; it's documentation.

# --- Auth.js / NextAuth (Phase 2) ---
# Signs the NextAuth session cookie. Any long random value; it does NOT need to
# match the backend AUTH_SECRET (the backend mints + validates its own token).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Base URL of the FastAPI backend (used by the API client + the Credentials
# provider's verify-student call). Defaults to http://127.0.0.1:8000 if unset.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Offline mock fallback for the API client. Unset = on in dev, off in production.
# Set "false" to force real errors even in dev; "true" to always allow mocks.
# NEXT_PUBLIC_USE_MOCKS=false

# --- OAuth providers (Phase 2, optional) ---
# Providers appear on /signin only when BOTH id + secret are present. Leave unset
# to ship SUT Student-ID login only. Set the callback URL in each provider console
# to: <site>/api/auth/callback/google  and  <site>/api/auth/callback/facebook
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# --- Deploy (non-Vercel hosts) ---
# Auth.js trusts the host via trustHost:true in src/auth.ts; if you prefer the env
# form instead, set AUTH_TRUST_HOST=true.
# AUTH_TRUST_HOST=true
